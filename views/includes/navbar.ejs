<style>
  .search-btn {
    background-color: #ff385c;
    color: #fff;
    border-radius: 25px;
    padding: 0.5rem 1.2rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .search-btn:hover {
    background-color: #e00b41;
    color: #fff;
    box-shadow: 0 4px 12px rgba(255, 56, 92, 0.35);
  }

  .search-btn i {
    display: inline;
    margin-right: 0.5rem;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 1.5rem;
    font-size: 0.95rem;
    border: 1px solid #dddddd;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .search-inp:focus {
    border-color: #ff385c;
    box-shadow: 0 0 0 3px rgba(255, 56, 92, 0.15);
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid px-4">
    <a class="navbar-brand text-danger font-weight-bold" href="/listings" style="font-size: 1.5rem; color: #ff385c !important;">
      <i class="fa-solid fa-compass me-2"></i><b>Trippa</b>
    </a>
    <button 
      class="navbar-toggler" 
      type="button" 
      data-bs-toggle="collapse" 
      data-bs-target="#navbarNavAltMarkup" 
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav me-auto">
        <a class="nav-link font-weight-bold" href="/listings" style="font-weight: 600;">Explore Stays</a>
      </div>
      <div class="navbar-nav mx-auto">
        <form class="d-flex" action="/listings" method="GET" role="search">
          <input class="form-control me-2 search-inp" name="search" type="search" placeholder="Search destinations, villas, cities..." value="<%= typeof search !== 'undefined' ? search : '' %>">
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>Search
          </button>
        </form>
      </div>
      <div class="navbar-nav ms-auto align-items-center">
        <a class="nav-link me-2" href="/listings/new" style="font-weight: 600;">Airbnb your home</a>
        <% if(!currUser) { %>
            <a class="nav-link me-2" href="/signup"><b>Sign up</b></a>
            <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %> <% if(currUser) { %>
            <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>