<% layout("/layouts/boilerplate") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<style>
  .show-container {
    max-width: 1120px;
    margin: 0 auto;
  }

  .show-title-box {
    margin-bottom: 1rem;
  }

  .show-title-box h2 {
    font-weight: 800;
    font-size: 1.75rem;
    color: #222222;
  }

  .show-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.9rem;
    color: #717171;
    margin-bottom: 1.5rem;
  }

  .show-meta-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hero-img-box {
    border-radius: 20px;
    overflow: hidden;
    height: 460px;
    width: 100%;
    margin-bottom: 2rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
  }

  .hero-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .host-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 1.25rem 0;
    border-bottom: 1px solid #ebebeb;
  }

  .host-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #ff385c;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.25rem;
  }

  .feature-item {
    display: flex;
    gap: 16px;
    margin-bottom: 1.25rem;
  }

  .feature-item i {
    font-size: 1.4rem;
    color: #222222;
    margin-top: 2px;
  }

  .amenities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .amenity-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0.75rem 1rem;
    border: 1px solid #eeeeee;
    border-radius: 12px;
    background: #fafafa;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .amenity-card i {
    font-size: 1.2rem;
    color: #ff385c;
  }

  /* Reserve Widget */
  .reserve-widget {
    border: 1px solid #dddddd;
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    position: sticky;
    top: 90px;
    background: #ffffff;
  }

  .reserve-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  .reserve-price {
    font-size: 1.4rem;
    font-weight: 800;
    color: #222222;
  }

  .reserve-dates-box {
    border: 1px solid #b0b0b0;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .reserve-dates-row {
    display: flex;
    border-bottom: 1px solid #b0b0b0;
  }

  .date-field {
    flex: 1;
    padding: 0.5rem 0.75rem;
  }

  .date-field:first-child {
    border-right: 1px solid #b0b0b0;
  }

  .date-field label {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #222222;
    display: block;
    margin: 0;
  }

  .date-field input {
    border: none;
    outline: none;
    font-size: 0.85rem;
    width: 100%;
    background: transparent;
  }

  .guests-field {
    padding: 0.5rem 0.75rem;
  }

  .guests-field label {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #222222;
    display: block;
    margin: 0;
  }

  .guests-field select {
    border: none;
    outline: none;
    width: 100%;
    font-size: 0.9rem;
    background: transparent;
  }

  .btn-reserve {
    background: linear-gradient(135deg, #e51e54 0%, #d70466 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 1.05rem;
    border-radius: 12px;
    padding: 0.85rem;
    width: 100%;
    border: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-reserve:hover {
    transform: scale(1.02);
    box-shadow: 0 6px 16px rgba(215, 4, 102, 0.4);
    color: #ffffff;
  }

  .price-calc-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    color: #484848;
    margin-bottom: 0.75rem;
  }

  .price-calc-row.total {
    border-top: 1px solid #dddddd;
    padding-top: 1rem;
    font-weight: 800;
    font-size: 1.1rem;
    color: #222222;
  }
</style>

<div class="show-container mt-3">
  <!-- Title & Meta Header -->
  <div class="show-title-box">
    <h2><%= listing.title %></h2>
    <div class="show-meta-bar">
      <div class="show-meta-left">
        <span><i class="fa-solid fa-star text-warning me-1"></i><b><%= listing.rating || 4.95 %></b> (<%= listing.reviewsCount || 48 %> reviews)</span>
        <span>•</span>
        <span class="text-dark font-weight-bold"><i class="fa-solid fa-award me-1 text-danger"></i>Superhost</span>
        <span>•</span>
        <u><%= listing.location %>, <%= listing.country %></u>
      </div>
      <div>
        <button class="btn btn-sm btn-outline-secondary me-2"><i class="fa-regular fa-heart me-1"></i>Save</button>
        <button class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-arrow-up-from-bracket me-1"></i>Share</button>
      </div>
    </div>
  </div>

  <!-- Hero Image -->
  <div class="hero-img-box">
    <img src="<%= listing.image ? listing.image.url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b' %>" alt="<%= listing.title %>">
  </div>

  <!-- Two Column Layout -->
  <div class="row g-5 mb-5">
    <!-- Left Column: Details & Amenities -->
    <div class="col-lg-7">
      <!-- Host Card -->
      <div class="host-card">
        <div class="host-avatar">
          <%= (listing.owner && listing.owner.username) ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
        </div>
        <div>
          <h5 class="m-0 font-weight-bold">Hosted by <%= (listing.owner && listing.owner.username) ? listing.owner.username : 'SuperHost' %></h5>
          <small class="text-muted">Superhost • 4 years hosting • 100% Response rate</small>
        </div>
      </div>

      <!-- Highlights -->
      <div class="py-4 border-bottom">
        <div class="feature-item">
          <i class="fa-solid fa-door-open"></i>
          <div>
            <h6 class="m-0 font-weight-bold">Self check-in</h6>
            <small class="text-muted">Check yourself in with the smart lock keypad.</small>
          </div>
        </div>
        <div class="feature-item">
          <i class="fa-solid fa-laptop-code"></i>
          <div>
            <h6 class="m-0 font-weight-bold">Dedicated workspace</h6>
            <small class="text-muted">A private room with fast Wi-Fi suited for working remotely.</small>
          </div>
        </div>
        <div class="feature-item">
          <i class="fa-solid fa-calendar-check"></i>
          <div>
            <h6 class="m-0 font-weight-bold">Free cancellation for 48 hours</h6>
            <small class="text-muted">Get a full refund if you change your plans.</small>
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="py-4 border-bottom">
        <h5 class="font-weight-bold mb-3">About this stay</h5>
        <p style="font-size: 1rem; line-height: 1.6; color: #484848;"><%= listing.description %></p>
      </div>

      <!-- Amenities -->
      <div class="py-4 border-bottom">
        <h5 class="font-weight-bold mb-3">What this place offers</h5>
        <div class="amenities-grid">
          <div class="amenity-card"><i class="fa-solid fa-wifi"></i> Fast Fiber Wifi (500 Mbps)</div>
          <div class="amenity-card"><i class="fa-solid fa-water-ladder"></i> Private Infinity Pool</div>
          <div class="amenity-card"><i class="fa-solid fa-utensils"></i> Chef's Kitchen</div>
          <div class="amenity-card"><i class="fa-solid fa-square-parking"></i> Free On-Premises Parking</div>
          <div class="amenity-card"><i class="fa-solid fa-snowflake"></i> Air Conditioning</div>
          <div class="amenity-card"><i class="fa-solid fa-tv"></i> 65" 4K Smart TV</div>
          <div class="amenity-card"><i class="fa-solid fa-hot-tub-person"></i> Private Hot Tub</div>
          <div class="amenity-card"><i class="fa-solid fa-mountain-sun"></i> Scenic Panoramic Views</div>
        </div>
      </div>

      <!-- Owner Edit / Delete Controls -->
      <% if(currUser && listing.owner && listing.owner._id && listing.owner._id.equals(currUser._id)) { %>
        <div class="py-4 border-bottom d-flex gap-3">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark px-4">Edit Listing</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-danger px-4">Delete Listing</button>
          </form>
        </div>
      <% } %>

      <!-- Reviews Section -->
      <div class="py-4 border-bottom">
        <h4 class="font-weight-bold mb-3"><i class="fa-solid fa-star text-warning me-2"></i><%= listing.rating || 4.95 %> • <%= listing.reviewsCount || 48 %> Guest Reviews</h4>
        
        <% if(currUser) { %>
          <div class="card p-3 mb-4 bg-light border-0">
            <h6 class="font-weight-bold mb-2">Leave a Review</h6>
            <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
              <div class="mb-3">
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                  <input type="radio" id="second-rate1" name="review[rating]" value="1" />
                  <label for="second-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="second-rate2" name="review[rating]" value="2" />
                  <label for="second-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="second-rate3" name="review[rating]" value="3" />
                  <label for="second-rate3" title="Average">3 stars</label>
                  <input type="radio" id="second-rate4" name="review[rating]" value="4" />
                  <label for="second-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="second-rate5" name="review[rating]" value="5" />
                  <label for="second-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>
              <div class="mb-3">
                <textarea name="review[comment]" placeholder="Share details of your experience at this stay..." cols="30" rows="3" class="form-control" required></textarea>
              </div>
              <button class="btn btn-dark btn-sm px-4">Submit Review</button>
            </form>
          </div>
        <% } %>

        <% if(listing.reviews && listing.reviews.length > 0) { %>
          <div class="row g-3">
            <% for(review of listing.reviews) { %>
              <div class="col-md-6">
                <div class="card h-100 p-3 border-0 shadow-sm bg-white">
                  <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center" style="width:36px; height:36px; font-weight:bold;">
                      <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'G' %>
                    </div>
                    <div>
                      <h6 class="m-0 font-weight-bold">@<%= review.author ? review.author.username : 'Guest' %></h6>
                      <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                    </div>
                  </div>
                  <p class="card-text text-muted" style="font-size: 0.9rem;"><%= review.comment %></p>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- Map Container -->
      <div class="py-4">
        <h5 class="font-weight-bold mb-3">Where you'll be</h5>
        <p class="text-muted"><%= listing.location %>, <%= listing.country %></p>
        <div id="map"></div>
      </div>
    </div>

    <!-- Right Column: Reserve Widget -->
    <div class="col-lg-5">
      <div class="reserve-widget">
        <div class="reserve-header">
          <div class="reserve-price">&#8377; <%= listing.price.toLocaleString("en-IN") %> <span style="font-size:0.95rem; font-weight:400; color:#717171;">/ night</span></div>
          <div><i class="fa-solid fa-star text-warning"></i> <b><%= listing.rating || 4.95 %></b> (<%= listing.reviewsCount || 48 %>)</div>
        </div>

        <div class="reserve-dates-box">
          <div class="reserve-dates-row">
            <div class="date-field">
              <label>CHECK-IN</label>
              <input type="date" id="checkInDate" value="2026-08-01">
            </div>
            <div class="date-field">
              <label>CHECKOUT</label>
              <input type="date" id="checkOutDate" value="2026-08-06">
            </div>
          </div>
          <div class="guests-field">
            <label>GUESTS</label>
            <select id="guestCountSelect">
              <option value="1">1 guest</option>
              <option value="2" selected>2 guests</option>
              <option value="3">3 guests</option>
              <option value="4">4 guests</option>
            </select>
          </div>
        </div>

        <button class="btn btn-reserve my-3" onclick="simulateReservation('<%= listing.title %>')">
          <i class="fa-solid fa-bolt me-2"></i>Reserve Stay Now
        </button>
        <p class="text-center text-muted small mb-4">You won't be charged yet</p>

        <div class="price-calc-row">
          <span>&#8377; <%= listing.price.toLocaleString("en-IN") %> x <span id="numNightsText">5</span> nights</span>
          <span>&#8377; <span id="subtotalPriceText"><%= (listing.price * 5).toLocaleString("en-IN") %></span></span>
        </div>
        <div class="price-calc-row">
          <span>Cleaning fee</span>
          <span>&#8377; 1,200</span>
        </div>
        <div class="price-calc-row">
          <span>Trippa service fee</span>
          <span>&#8377; 850</span>
        </div>
        <div class="price-calc-row total">
          <span>Total before taxes</span>
          <span>&#8377; <span id="totalPriceText"><%= (listing.price * 5 + 1200 + 850).toLocaleString("en-IN") %></span></span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function simulateReservation(title) {
    const total = document.getElementById("totalPriceText").innerText;
    alert(`🎉 Reservation Confirmed for "${title}"!\n\nTotal: ₹${total}\nThank you for booking with Trippa StayFinder.`);
  }
</script>

<script src="/js/map.js"></script>